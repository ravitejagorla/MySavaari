# ============================================================
# MySavaari Environment Configuration
# ============================================================
# Copy this file to .env and provide your local values.
# NEVER commit the real .env file.
# ============================================================


# Project Phase (development, staging, production)
PROJECT_PHASE=

# ============================================================
# Django
# ============================================================
SECRET_KEY=

# ============================================================
# Host
# ============================================================

# Comma-separated list of allowed hosts.
# Development example:
HOST_DOMAIN=localhost,127.0.0.1


# ============================================================
# Cryptography
# ============================================================

CRYPTOGRAPHY_ENCRYPTION_ID=


# ============================================================
# CORS
# ============================================================

# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200


# ============================================================
# Database Configuration
# ============================================================

# Primary database
# PostgreSQL is always required.

DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432


# ============================================================
# Secondary Database
# ============================================================

# Set to True only when the secondary database is available.
#
# True  -> MySQL configuration is loaded
# False -> MySQL configuration is ignored

USE_SECONDARY_DB=False

DB_ENGINE2=django.db.backends.mysql
DB_NAME2=
DB_USER2=
DB_PASSWORD2=
DB_HOST2=localhost
DB_PORT2=3306


# ============================================================
# Language & Timezone
# ============================================================

LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kolkata

USE_I18N=True
USE_TZ=True


# ============================================================
# Static Files
# ============================================================

STATIC_URL=static/
STATIC_ROOT=staticfiles/


# ============================================================
# Media Files
# ============================================================

MEDIA_URL=media/
MEDIA_ROOT=media/

# ============================================================
# Redis
# ============================================================
# Local defaults target a Redis server running on this machine. For Docker,
# set REDIS_HOST=redis or provide full redis:// URLs below.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CHANNEL_LAYER_DB=0
REDIS_CELERY_BROKER_DB=10
REDIS_CELERY_RESULT_DB=11

# Optional full URLs. These override the host, port, and database settings
# above and support authenticated or TLS Redis deployments.
REDIS_CHANNEL_LAYER_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Kolkata

# ============================================================
# ZeptoMail
# ============================================================

ZEPTO_MAIN_API_KEY=
ZEPTO_MAIL_ID=


# ============================================================
# Email / SMTP
# ============================================================

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True


# ============================================================
# Razorpay
# ============================================================

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
